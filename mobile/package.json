{
  "name": "pets-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Sao_Paulo jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@pets/core": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "57.0.15",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.13",
    "expo-device": "57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.5",
    "expo-image": "57.0.3",
    "expo-image-picker": "57.0.12",
    "expo-linking": "57.0.7",
    "expo-notifications": "57.0.13",
    "expo-router": "57.0.15",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "57.0.14",
    "expo-splash-screen": "57.0.7",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-web-browser": "57.0.2",
    "lucide-react-native": "1.33.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.66.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|nativewind|react-native-css-interop|test-renderer|standard-navigation|@pets/.*))"
    ],
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/__mocks__/style.js",
      "^react$": "<rootDir>/../node_modules/react",
      "^react/(.*)$": "<rootDir>/../node_modules/react/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 30000
  }
}
