# The API and the web app, each on its own name, with certificates from
# Let's Encrypt (HTTP challenge: both names must point at this host).

api.pets.ampulla.tech {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy pets:8000
}

pets.ampulla.tech {
	encode zstd gzip
	root * /srv/web
	# The service worker must always be fetched fresh, or a deploy never reaches
	# an installed app.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
